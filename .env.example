# Copy to .env and fill values locally. .env must never be committed.
# Use a scoped Cloudflare API token for the intended account and Worker.
# Deployment credentials are never sent to browsers or collaboration clients.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COLLABORATION_WORKER_NAME=visual-nerve-collaboration
COLLABORATION_WORKER_URL=
# Public isolated-app build pin only; optional and disabled by default.
# Match the reviewed HTTPS worker origin exactly, without a trailing slash.
COLLABORATION_RELAY_ORIGIN=
COLLABORATION_ALLOWED_ORIGINS=https://app.visualnerve.com
