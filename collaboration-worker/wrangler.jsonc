{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-nerve-collaboration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://app.visualnerve.com",
    "ENABLED": "false",
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CollaborationRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollaborationRoom"] }],
  "ratelimits": [
    {
      "name": "ADMISSION_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "limits": { "cpu_ms": 50 },
}
